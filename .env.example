# ============================================================
# 复制本文件为 .env 后按需修改（.env 不会被提交到 git）
# Copy this file to .env and edit it (.env is git-ignored)
# ============================================================

# ---------- 定时规则 / Schedule ----------
# 5 段 cron 表达式：分 时 日 月 周，默认每天 09:30 执行
# 5-field cron: minute hour day-of-month month day-of-week
SCHEDULE_CRON=30 9 * * *
SCHEDULE_TIMEZONE=Asia/Shanghai
# 启动进程时是否立刻先跑一次（true/false）
RUN_ON_START=false

# ---------- 浏览器 / Browser ----------
# 留空则使用 puppeteer 自带的 Chromium；服务器装了 Chrome 时可指向它
# Leave empty to use bundled Chromium; set a path to use system Chrome
CHROME_PATH=
HEADLESS=true
# 同时截图的页面数（1 最稳，2~4 更快）
MAX_CONCURRENCY=2

# ---------- 截图 / Capture ----------
# 单页面导航超时（毫秒）
NAVIGATION_TIMEOUT=30000
# networkidle2（推荐）/ domcontentloaded / load
WAIT_UNTIL=networkidle2
# 截图前的额外等待（毫秒），给懒加载图片留时间
EXTRA_WAIT=1500
FULL_PAGE=true
# 站点打不开时的重试次数（总尝试次数 = CAPTURE_RETRIES + 1）
CAPTURE_RETRIES=2
CAPTURE_RETRY_DELAY=3000
# 单张截图超过该体积(MB)时，自动降级为仅截首屏
MAX_IMAGE_MB=10
# 页面文本少于该字符数时判定为“疑似空白”，会多等 3 秒再截
MIN_CONTENT_LENGTH=50
# 截图前自动滚动页面以触发图片懒加载
AUTO_SCROLL=true
BROWSER_LAUNCH_TIMEOUT=60000

# ---------- 存储 / Storage ----------
SCREENSHOT_DIR=screenshots
# 历史截图保留天数，0 表示永不清理
RETENTION_DAYS=7

# ---------- 邮件 / Mail ----------
# 不填邮箱配置时程序仍然会截图并保存到本地，只是不发邮件
# If mail is not configured, screenshots are still saved locally (no email sent)
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASS=your-password-or-app-key
MAIL_TO=someone@example.com,other@example.com
MAIL_CC=
MAIL_FROM=site-shot <your@email.com>
MAIL_SUBJECT_PREFIX=网站截图日报
# 附件总大小上限(MB)，超出则只发文字报告
MAX_ATTACHMENT_MB=15
# 发信失败重试次数与 SMTP 超时(ms)
MAIL_RETRIES=3
SMTP_TIMEOUT=20000

# ---------- Web 控制台 / Web dashboard ----------
# npm run web 后浏览器打开 http://127.0.0.1:3000
WEB_PORT=3000
# 需要局域网访问时改为 0.0.0.0（建议同时设置下面的账号密码）
WEB_HOST=127.0.0.1
# 留空表示不开启登录验证；填写后启用 HTTP Basic 认证
WEB_USER=
WEB_PASS=

# ---------- 日志 / Logging ----------
LOG_LEVEL=info
# 留空只输出到控制台；填路径则同时写文件
LOG_FILE=logs/run.log
